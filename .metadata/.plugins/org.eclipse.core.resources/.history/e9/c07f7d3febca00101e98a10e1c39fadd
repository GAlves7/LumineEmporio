services:
  backend:
    image: aplicacao-spring
    container_name: back_lumine
    ports:
      - "8080:8080"
    environment:
      SPRING_DATASOURCE_URL: jdbc:mysql://SEU_HOST:3306/NOME_DO_BANCO?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
      SPRING_DATASOURCE_USERNAME: SEU_USUARIO
      SPRING_DATASOURCE_PASSWORD: SUA_SENHA
    volumes:
      - imagens:/app/imagens

volumes:
  imagens: